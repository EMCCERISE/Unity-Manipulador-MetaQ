--- !u!114 &1025175573
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1025175561}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"lss_arm_system\" type=\"system\">\r\n  <hardware>\r\n   
    <plugin>ign_ros2_control/IgnitionSystem</plugin>\r\n  </hardware>\r\n  <joint
    name=\"lss_arm_joint_1\">\r\n    <param name=\"initial_position\">0.0</param>\r\n   
    <command_interface name=\"position\">\r\n      <param name=\"min\">-3.14</param>\r\n     
    <param name=\"max\">3.14</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\" />\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"lss_arm_joint_2\">\r\n   
    <param name=\"initial_position\">1.7</param>\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">-2.18</param>\r\n      <param name=\"max\">2.18</param>\r\n   
    </command_interface>\r\n    <state_interface name=\"position\" />\r\n    <state_interface
    name=\"velocity\" />\r\n    <state_interface name=\"effort\" />\r\n  </joint>\r\n 
    <joint name=\"lss_arm_joint_3\">\r\n    <param name=\"initial_position\">-0.7</param>\r\n   
    <command_interface name=\"position\">\r\n      <param name=\"min\">-1.92</param>\r\n     
    <param name=\"max\">1.57</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\" />\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"lss_arm_joint_4\">\r\n   
    <param name=\"initial_position\">-1.7</param>\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">-2</param>\r\n      <param name=\"max\">2</param>\r\n   
    </command_interface>\r\n    <state_interface name=\"position\" />\r\n    <state_interface
    name=\"velocity\" />\r\n    <state_interface name=\"effort\" />\r\n  </joint>\r\n 
    <joint name=\"lss_arm_joint_5\">\r\n    <param name=\"initial_position\">0.0</param>\r\n   
    <command_interface name=\"position\">\r\n      <param name=\"min\">0</param>\r\n     
    <param name=\"max\">0.8</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\" />\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n</ros2_control>"
